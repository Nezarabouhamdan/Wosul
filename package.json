{
  "name": "wosul-website",
  "version": "1.0.0",
  "private": true,
  "description": "Wosul (وصول) studio website: static bilingual pages plus a contact form API on Cloudflare Workers + D1.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build.ts",
    "deploy": "wrangler deploy",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/worker && tsc -p src/client",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "db:migrate:local": "wrangler d1 migrations apply wosul-inquiries --local",
    "db:migrate:remote": "wrangler d1 migrations apply wosul-inquiries --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
